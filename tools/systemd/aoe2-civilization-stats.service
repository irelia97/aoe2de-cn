[Unit]
Description=Download, clean and publish weekly AoE2 civilization statistics
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=2d
StartLimitBurst=24
OnFailure=aoe2-site-alert@%n.service

[Service]
Type=oneshot
User=root
Group=aoe2
WorkingDirectory=/opt/aoe2de-cn
ExecStart=/var/lib/aoe2-match-data/.venv/bin/python /opt/aoe2de-cn/tools/update-civilization-stats.py
Restart=on-failure
RestartSec=1h
TimeoutStartSec=2h
MemoryMax=1200M
CPUQuota=100%
Nice=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aoe2-match-data
